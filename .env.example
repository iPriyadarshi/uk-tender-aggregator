# --- Neon (production / Vercel) ---
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

# --- Local Postgres (development) ---
# Password with special chars must be URL-encoded (@ → %40, # → %23, etc.)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/uk_gov_contracts

# Protect cron endpoint (Vercel sends Authorization: Bearer <secret>)
CRON_SECRET=generate-a-long-random-string

# Public app URL for User-Agent contact
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional custom scraper user-agent
SCRAPER_USER_AGENT=ChardiTrialBot/1.0 (+https://your-app.vercel.app; contact=you@email.com)

# Windows only: if PCS/Sell2Wales TLS fails, use npm run ingest:* (includes --use-system-ca) or:
INGEST_TLS_SKIP_VERIFY=true

# 2Captcha api key for captcha bypass
TWOCAPTCHA_API_KEY=your_api_key